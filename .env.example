# Your live domain (no trailing slash). Used for canonical URLs, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://rafikihub.com

# Postgres connection string. On Vercel this is added for you when you connect Neon.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Master login (/login). Opens the admin at /admin and both the Performer and Casting dashboards.
MASTER_PASSWORD=choose-a-long-password

# Signs the dashboard session cookies. Required in production: a long random string that is NOT the
# master password (make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# Changing it signs everyone out.
SESSION_SECRET=

# Vercel Blob read-write token, for photo, showreel and voice clip uploads (Vercel → Storage → Blob).
# Works wherever the site runs, Hostinger included. Without it, paste links instead of uploading.
BLOB_READ_WRITE_TOKEN=

# Where links in emails point (reset links, "Open the inbox"), no trailing slash. Set it wherever the site
# runs: https://rafikihub-b42r.vercel.app until rafikihub.com is connected to this site.
APP_URL=https://rafikihub.com

# Email (password resets and form alerts to the team), through Elastic Email (elasticemail.com).
# EMAIL_FROM must be on a domain verified there. RESEND_API_KEY also works instead, if you ever switch.
ELASTIC_EMAIL_API_KEY=
# Optional: where form alerts go (default info@rafikihub.com)
NOTIFY_EMAIL=
EMAIL_FROM=RafikiHub <no-reply@rafikihub.com>

# Where the old site's uploaded files (/assets/...) are served from once this site takes over rafikihub.com,
# e.g. a Hostinger subdomain pointing at the old site's folder. Leave empty until then.
LEGACY_ASSETS_URL=
